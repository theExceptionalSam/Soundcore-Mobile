# Copy this file to .env and fill in real values.
# DO NOT commit .env — it's already in .gitignore.

# The password the owner types to log in to the admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random secret used to sign session cookies.
# Generate one with: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-to-a-random-32-char-string

# GitHub fine-grained PAT with "Contents: Read and write" on the Soundcore-Mobile repo
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repo to read/write (the live marketing site)
GITHUB_OWNER=theExceptionalSam
GITHUB_REPO=Soundcore-Mobile
